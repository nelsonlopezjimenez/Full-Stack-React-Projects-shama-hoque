# Copy to .env (git-ignored) and adjust: cp .env.example .env

# Where `npm run dev` / `npm run preview` forward /api requests (the Express server).
API_PROXY_TARGET=http://localhost:3000

# Only when the client is deployed on its OWN origin (e.g. a CDN) and calls the API directly.
# Leave empty to use relative /api URLs (Vite proxy in dev, same origin in production).
# The server must then list this client's origin in its CORS_ORIGIN.
# Variables starting with VITE_ are copied INTO the browser bundle: never put secrets here.
VITE_API_URL=
