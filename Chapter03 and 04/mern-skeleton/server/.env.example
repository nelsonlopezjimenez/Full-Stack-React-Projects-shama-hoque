# Copy this file to .env and adjust the values: cp .env.example .env
# .env is git-ignored; .env.example is committed so everyone knows which variables exist.
# Own database name (mernskeleton) so this chapter does not share data with Chapter 5 (mernproject).
PORT=3000
MONGODB_URI=mongodb://localhost:27017/mernskeleton
JWT_SECRET=change-me-to-a-long-random-string
