# Copy this file to .env and adjust the values: cp .env.example .env
# .env is git-ignored; .env.example is committed so everyone knows which variables exist.
# Own database name (mernskeleton) so this chapter does not share data with Chapter 5 (mernproject).
PORT=3000
# ?directConnection=true: talk only to this host. Needed when the local MongoDB is a replica set whose
# members advertise a name your machine cannot resolve (e.g. a Docker container called "mongodb").
MONGODB_URI=mongodb://localhost:27017/mernskeleton?directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jsonwebtoken format: 15m, 12h, 1d ...) and the cookie lifetime in ms (keep them equal)
JWT_EXPIRES_IN=1d
JWT_COOKIE_MAX_AGE_MS=86400000
# Only when the client runs on another origin (comma-separated). Leave empty for the Vite proxy.
# CORS_ORIGIN=http://localhost:4173
