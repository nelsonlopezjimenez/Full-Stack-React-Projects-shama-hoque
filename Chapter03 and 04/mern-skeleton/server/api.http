@baseUrl = http://localhost:3000
@password = secret1

### 1. The root URL → 404 "Cannot GET /" (since stage 07e the server only answers under /api)
GET {{baseUrl}}/

### 2. List users → 200 and a JSON array (the users survive a restart now)
GET {{baseUrl}}/api/users

### 3. Create a user → 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Ann", "email": "ann@test.io", "password": "{{password}}" }

### 4. Create a user with NO data → 400 with ALL validation messages
POST {{baseUrl}}/api/users
Content-Type: application/json

{}

### 5. Create Ann AGAIN → 400 "Email already exists"
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Ann", "email": "ann@test.io", "password": "{{password}}" }

### 6. A second user, for the next stages → 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Bob", "email": "bob@test.io", "password": "{{password}}" }

### 7. List users and store the answer
# @name list
GET {{baseUrl}}/api/users

###
@userId = {{list.response.body.$[0]._id}}

### 8. Read one user → 200 and the user, without the password
GET {{baseUrl}}/api/users/{{userId}}

### 9. A valid id that belongs to nobody → 404 { "error": "User not found" }
GET {{baseUrl}}/api/users/000000000000000000000000

### 10. Something that is not an id at all → 400 "Invalid _id: not-an-id"
GET {{baseUrl}}/api/users/not-an-id

### 11. A user to delete → 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Dan", "email": "dan@test.io", "password": "{{password}}" }

### 12. Delete a user → 200 and the deleted user
@deleteId = paste-an-id-here
DELETE {{baseUrl}}/api/users/{{deleteId}}

### 13. Delete the same user again → 404 (it is gone)
DELETE {{baseUrl}}/api/users/{{deleteId}}

### 14. Change only the name → 200, the user with the new name and an "updated" date
PATCH {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{ "name": "Ann Updated" }

### 15. An invalid email → 400 "Please fill a valid email address."
PATCH {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{ "email": "not-an-email" }

### 16. Unknown API route → JSON 404
GET {{baseUrl}}/api/nope

### 17. Broken JSON (a missing quote) → 400, not 500
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Ann, "email": "x@test.io" }

### 18. A password that is too short → 400 "Password must be at least 6 characters."
POST {{baseUrl}}/api/users
Content-Type: application/json

{ "name": "Eve", "email": "eve@test.io", "password": "123" }

### 19. Sign in → 200 { token, user } + httpOnly cookie "t"
# @name signin
POST {{baseUrl}}/api/auth/sessions
Content-Type: application/json

{ "email": "ann@test.io", "password": "{{password}}" }

### 20. Wrong password → 401 (the same message as an unknown email)
POST {{baseUrl}}/api/auth/sessions
Content-Type: application/json

{ "email": "ann@test.io", "password": "wrong-password" }

### 21. Unknown email → 401, same message
POST {{baseUrl}}/api/auth/sessions
Content-Type: application/json

{ "email": "nobody@test.io", "password": "{{password}}" }

### 22. Missing fields → 400
POST {{baseUrl}}/api/auth/sessions
Content-Type: application/json

{}

### 23. Read a user WITHOUT the cookie → 401 "UnauthorizedError: No authorization token was found"
# @no-cookie-jar
GET {{baseUrl}}/api/users/{{userId}}

### 24. Sign out → 200, cookie cleared. Request 8 now answers 401 until you sign in again.
DELETE {{baseUrl}}/api/auth/sessions

### 25. A cookie made up by hand, without any sign-in → 401 "jwt malformed"
# @no-cookie-jar
GET {{baseUrl}}/api/users/{{userId}}
Cookie: t={{userId}}

### 26. Signed in as Ann, change BOB's account → 403 "User is not authorized"
@bobId = {{list.response.body.$[1]._id}}
PATCH {{baseUrl}}/api/users/{{bobId}}
Content-Type: application/json

{ "name": "Bob was here" }

### 27. A hand-made cookie with BOB's id → 401 "jwt malformed"
# @no-cookie-jar
PATCH {{baseUrl}}/api/users/{{bobId}}
Cookie: t={{bobId}}
Content-Type: application/json

{ "name": "Bob, hacked" }

### 28. No cookie, the token in a header instead (what a mobile app would do) → 200
@token = {{signin.response.body.token}}
# @no-cookie-jar
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{token}}
