{
  "name": "mern-social",
  "version": "3.0.0",
  "description": "A MERN stack based social media application",
  "author": "Shama Hoque",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "express",
    "mongodb",
    "node",
    "mern"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shamahoque/mern-social.git"
  },
  "homepage": "https://github.com/shamahoque/mern-social",
  "scripts": {
    "dev": "nodemon",
    "dev:client": "vite",
    "dev:client:host": "vite --host",
    "build": "vite build",
    "start": "node server/server.js",
    "test:server": "vitest run --config vitest.config.js",
    "test:client": "vitest run --config vite.config.js",
    "test:watch:server": "vitest --config vitest.config.js",
    "test:watch:client": "vitest --config vite.config.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "formidable": "^2.1.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1",
    "tss-react": "^4.9.20"
  }
}
